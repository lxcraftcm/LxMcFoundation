<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 验证工程只从 Central 验证仓库消费 Foundation，不参与正式发布。 -->
    <groupId>io.github.lxcraftcm.verification</groupId>
    <artifactId>foundation-central-consumer</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <!-- 工作流必须显式传入待验证的 Foundation 正式版本。 -->
        <foundation.version>0.0.0-UNSET</foundation.version>
    </properties>

    <dependencies>
        <!-- 拉取 Bukkit 模块会同时验证父 POM 和 Core 模块的远程解析链路。 -->
        <dependency>
            <groupId>io.github.lxcraftcm</groupId>
            <artifactId>foundation-bukkit</artifactId>
            <version>${foundation.version}</version>
        </dependency>
    </dependencies>
</project>
