<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承公共库的 Java、依赖与构建版本约束。 -->
    <parent>
        <groupId>io.github.lxcraftcm</groupId>
        <artifactId>lxmc-foundation</artifactId>
        <version>0.1.0</version>
    </parent>

    <!-- 核心模块不依赖 Bukkit 运行时对象。 -->
    <artifactId>foundation-core</artifactId>
    <name>LxMcFoundation Core</name>

    <dependencies>
        <!-- JSON 文件持久化运行时需要 Gson，最终业务插件通过 Shade 一并内置。 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- JUnit 只用于公共缓存、队列和持久化契约测试。 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 按父工程的 Java 8 目标编译公共核心代码。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- 执行核心模块的 JUnit 测试。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
